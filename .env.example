# Copy to `.env` and fill in. Vite inlines these at build time, so a rebuild is needed
# after changing them — and whatever you put here ends up readable inside the shipped
# bundle. That is fine for an endpoint you are willing to serve the extension's users
# from, and not fine for anything you would call a secret.

# The chain RPC. Required — without it every read fails and the wallet shows no
# balances. Providers like Alchemy and Infura put the API key in the path, which is why
# this is not committed.
VITE_RPC_URL=

# Optional. The indexer serves note commitments and nullifiers; without it the wallet
# falls back to scanning logs directly over the RPC, which is slower but works.
VITE_INDEXER_URL=

# Optional. The relayer submits withdrawals so the gas payer and the timing do not
# deanonymise the exit. Without it, withdrawals are disabled — deposits and swaps still
# work. Falls back to VITE_INDEXER_URL when unset.
VITE_RELAYER_URL=
