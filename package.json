{
  "name": "sherwood-wallet-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A self-custodial Chrome wallet that deposits into, swaps inside and withdraws out of the Sherwood privacy pool.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^5.7.2",
    "ffjavascript": "^0.3.1",
    "fixed-merkle-tree": "^0.7.3",
    "poseidon-lite": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
